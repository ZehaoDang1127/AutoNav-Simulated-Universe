+// Route preference learned from estimated odometry, never from course geometry.
+#ifndef NAV2_SMAC_PLANNER__TRAVELED_CORRIDOR_HPP_
+#define NAV2_SMAC_PLANNER__TRAVELED_CORRIDOR_HPP_
+#include <algorithm>
+#include <cmath>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <vector>
+#include "nav2_costmap_2d/costmap_2d.hpp"
+#include "nav2_costmap_2d/cost_values.hpp"
+
+namespace nav2_smac_planner {
+class TraveledCorridor {
+public:
+  struct FrameTransform {
+    std::string source_frame, target_frame;
+    double x, y, yaw;
+  };
+  std::string frame() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return frame_;
+  }
+  void record(double x, double y, const std::string & frame) {
+    if (!std::isfinite(x) || !std::isfinite(y) || frame.empty()) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (frame_ != frame) {points_.clear(); frame_ = frame; distance_ = 0;}
+    if (!points_.empty()) {
+      const double step = std::hypot(x-points_.back().x, y-points_.back().y);
+      if (step < 0.10) return;
+      // A localization reset is not evidence of a traversable connection.
+      if (step > 2.0) {points_.clear(); distance_ = 0;}
+      else distance_ += step;
+    }
+    points_.push_back({x, y, distance_});
+    if (points_.size() > 20000) points_.pop_front();
+  }
+
+  bool applyReturnMask(nav2_costmap_2d::Costmap2D & map, double goal_x,
+    double goal_y, const std::string & frame, double radius,
+    double goal_distance, double minimum_travel,
+    const FrameTransform * transform = nullptr) const
+  {
+    std::vector<Point> points;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (points_.size() < 2) return false;
+      if (frame != frame_ && (!transform || transform->source_frame != frame_ ||
+          transform->target_frame != frame || !std::isfinite(transform->x) ||
+          !std::isfinite(transform->y) || !std::isfinite(transform->yaw))) return false;
+      points.assign(points_.begin(), points_.end());
+      if (frame != frame_) {
+        const double c = std::cos(transform->yaw), s = std::sin(transform->yaw);
+        for (auto & p : points) {
+          const double x = p.x, y = p.y;
+          p.x = transform->x + c*x - s*y;
+          p.y = transform->y + s*x + c*y;
+        }
+      }
+      bool revisited = false;
+      for (const auto & p : points) {
+        if (distance_-p.distance >= minimum_travel &&
+            std::hypot(goal_x-p.x, goal_y-p.y) <= goal_distance) {
+          revisited = true; break;
+        }
+      }
+      if (!revisited) return false;
+    }
+    const int width = map.getSizeInCellsX(), height = map.getSizeInCellsY();
+    const double res = map.getResolution(), ox = map.getOriginX(), oy = map.getOriginY();
+    std::vector<bool> allowed(width*height, false);
+    const auto stamp = [&](double x, double y) {
+      const int x0 = std::max(0, static_cast<int>(std::floor((x-radius-ox)/res)));
+      const int y0 = std::max(0, static_cast<int>(std::floor((y-radius-oy)/res)));
+      const int x1 = std::min(width-1, static_cast<int>(std::floor((x+radius-ox)/res)));
+      const int y1 = std::min(height-1, static_cast<int>(std::floor((y+radius-oy)/res)));
+      for (int my=y0; my<=y1; ++my) for (int mx=x0; mx<=x1; ++mx) {
+        if (std::hypot(ox+(mx+.5)*res-x, oy+(my+.5)*res-y) <= radius) {
+          allowed[my*width+mx] = true;
+        }
+      }
+    };
+    stamp(points.front().x, points.front().y);
+    for (size_t i=1; i<points.size(); ++i) {
+      const auto & a=points[i-1]; const auto & b=points[i];
+      const int steps=std::max(1,static_cast<int>(std::ceil(std::hypot(b.x-a.x,b.y-a.y)/0.10)));
+      for (int j=1; j<=steps; ++j) {
+        const double f=static_cast<double>(j)/steps;
+        stamp(a.x+f*(b.x-a.x), a.y+f*(b.y-a.y));
+      }
+    }
+    // Modify the private planning snapshot only. Never lower sensed costs.
+    auto * costs=map.getCharMap();
+    for (size_t i=0; i<allowed.size(); ++i) {
+      if (!allowed[i]) costs[i]=nav2_costmap_2d::LETHAL_OBSTACLE;
+    }
+    return true;
+  }
+private:
+  struct Point {double x, y, distance;};
+  mutable std::mutex mutex_;
+  std::deque<Point> points_;
+  std::string frame_;
+  double distance_{0};
+};
+}  // namespace nav2_smac_planner
+#endif
