+#ifndef NAV2_SMAC_PLANNER__LATTICE_GOAL_HPP_
+#define NAV2_SMAC_PLANNER__LATTICE_GOAL_HPP_
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <vector>
+#include "nav2_smac_planner/collision_checker.hpp"
+
+namespace nav2_smac_planner
+{
+
+// For a position goal with unconstrained yaw, prefer the requested lattice
+// heading when clear, otherwise choose the nearest clear arrival heading.
+// The search reaches this heading directly; no rotation to the blocked yaw
+// is required. The requested goal position is never moved.
+inline bool selectCollisionFreeLatticeGoal(
+  GridCollisionChecker & checker, float x, float y, double requested_yaw,
+  const std::vector<float> & headings, bool traverse_unknown, unsigned int & heading)
+{
+  const double bins = checker.getPrecomputedAngles().size();
+  double best_distance = std::numeric_limits<double>::infinity();
+  for (unsigned int candidate = 0; candidate < headings.size(); ++candidate) {
+    const double delta = std::atan2(std::sin(headings[candidate] - requested_yaw),
+      std::cos(headings[candidate] - requested_yaw));
+    if (std::abs(delta) >= best_distance) {continue;}
+    double angle = std::fmod(headings[candidate], 2.0*M_PI);
+    if (angle < 0.0) {angle += 2.0*M_PI;}
+    if (!checker.inCollision(x, y, angle*bins/(2.0*M_PI), traverse_unknown)) {
+      heading = candidate;
+      best_distance = std::abs(delta);
+    }
+  }
+  return std::isfinite(best_distance);
+}
+
+// When every heading at the requested cell is occupied, explicitly select
+// the nearest clear cell inside the existing world-position tolerance. This
+// keeps an occupied exact goal from exhausting the search before its tolerant
+// fallback reaches a nearby clear arrival. A moved cell must be searched with
+// zero additional tolerance, so tolerances cannot compound.
+inline bool selectCollisionFreeLatticeGoalWithinTolerance(
+  GridCollisionChecker & checker, const nav2_costmap_2d::Costmap2D & map,
+  double requested_x, double requested_y, double requested_yaw,
+  const std::vector<float> & headings, bool traverse_unknown, double tolerance,
+  unsigned int & x, unsigned int & y, unsigned int & heading)
+{
+  if (selectCollisionFreeLatticeGoal(
+      checker, x, y, requested_yaw, headings, traverse_unknown, heading))
+  {
+    return true;
+  }
+  if (!std::isfinite(tolerance) || tolerance <= 0.0) {return false;}
+  struct Candidate {double distance; unsigned int x; unsigned int y;};
+  std::vector<Candidate> candidates;
+  const double resolution = map.getResolution();
+  const double grid_x = (requested_x-map.getOriginX())/resolution-.5;
+  const double grid_y = (requested_y-map.getOriginY())/resolution-.5;
+  const double radius = tolerance/resolution;
+  const int min_x = std::max(0, static_cast<int>(std::ceil(grid_x-radius)));
+  const int max_x = std::min(static_cast<int>(map.getSizeInCellsX())-1,
+    static_cast<int>(std::floor(grid_x+radius)));
+  const int min_y = std::max(0, static_cast<int>(std::ceil(grid_y-radius)));
+  const int max_y = std::min(static_cast<int>(map.getSizeInCellsY())-1,
+    static_cast<int>(std::floor(grid_y+radius)));
+  for (int cy = min_y; cy <= max_y; ++cy) {
+    for (int cx = min_x; cx <= max_x; ++cx) {
+      const double distance = std::hypot(cx-grid_x, cy-grid_y)*resolution;
+      if (distance <= tolerance) {
+        candidates.push_back({distance, static_cast<unsigned int>(cx),
+          static_cast<unsigned int>(cy)});
+      }
+    }
+  }
+  std::sort(candidates.begin(), candidates.end(), [](const Candidate & a, const Candidate & b) {
+    return a.distance < b.distance;
+  });
+  for (const auto & candidate : candidates) {
+    unsigned int candidate_heading = heading;
+    if (selectCollisionFreeLatticeGoal(
+        checker, candidate.x, candidate.y, requested_yaw, headings,
+        traverse_unknown, candidate_heading))
+    {
+      x = candidate.x;
+      y = candidate.y;
+      heading = candidate_heading;
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace nav2_smac_planner
+#endif  // NAV2_SMAC_PLANNER__LATTICE_GOAL_HPP_
