@@ -0,0 +1,50 @@
+#ifndef NAV2_SMAC_PLANNER__LATTICE_START_HPP_
+#define NAV2_SMAC_PLANNER__LATTICE_START_HPP_
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <vector>
+#include "nav2_smac_planner/collision_checker.hpp"
+
+namespace nav2_smac_planner
+{
+
+// Connect the measured pose to a discrete lattice heading at the same
+// continuous position. Snapping the center or blindly choosing the nearest
+// heading can put an otherwise clear padded body into an obstacle.
+inline bool selectCollisionFreeLatticeStart(
+  GridCollisionChecker & checker, float x, float y, double yaw,
+  const std::vector<float> & headings, bool traverse_unknown, unsigned int & heading)
+{
+  const double bins = checker.getPrecomputedAngles().size();
+  const auto collides = [&](double angle) {
+      angle = std::fmod(angle, 2.0 * M_PI);
+      if (angle < 0.0) {angle += 2.0 * M_PI;}
+      return checker.inCollision(x, y, angle * bins / (2.0 * M_PI), traverse_unknown);
+    };
+  if (collides(yaw)) {
+    return false;
+  }
+  double best_distance = std::numeric_limits<double>::infinity();
+  for (unsigned int candidate = 0; candidate < headings.size(); ++candidate) {
+    const double delta = std::atan2(std::sin(headings[candidate] - yaw),
+      std::cos(headings[candidate] - yaw));
+    if (std::abs(delta) >= best_distance) {
+      continue;
+    }
+    const int steps = std::max(1, static_cast<int>(std::ceil(std::abs(delta) / 0.05)));
+    bool safe = true;
+    for (int step = 1; step <= steps && safe; ++step) {
+      safe = !collides(yaw + delta * static_cast<double>(step) / steps);
+    }
+    if (safe) {
+      heading = candidate;
+      best_distance = std::abs(delta);
+    }
+  }
+  return std::isfinite(best_distance);
+}
+
