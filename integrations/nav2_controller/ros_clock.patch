+// Copyright 2026 AutoNav contributors
+// Licensed under the Apache License, Version 2.0.
+#ifndef NAV2_CONTROLLER__ROS_CLOCK_RATE_HPP_
+#define NAV2_CONTROLLER__ROS_CLOCK_RATE_HPP_
+
+#include <chrono>
+#include <cmath>
+#include <functional>
+#include <stdexcept>
+#include <thread>
+#include "rclcpp/rclcpp.hpp"
+
+namespace nav2_controller
+{
+// rclcpp::Rate in Humble uses system time. Poll the node clock instead so
+// control-sequence shifts consume the same interval as simulated motion.
+// The short wall wait also permits action cancellation when ROS time stops.
+class ROSClockRate
+{
+public:
+  ROSClockRate(rclcpp::Clock::SharedPtr clock, double frequency)
+  : clock_(std::move(clock)), period_(periodFromFrequency(frequency)),
+    last_observed_(clock_->now()), next_(last_observed_ + period_) {}
+
+  bool sleep(const std::function<bool()> & keep_running)
+  {
+    while (keep_running()) {
+      const auto current = clock_->now();
+      if (current < last_observed_) {
+        // A restarted simulation must not wait for the previous run's time.
+        next_ = current + period_;
+      }
+      last_observed_ = current;
+      if (current >= next_) {
+        const bool missed = current - next_ >= period_;
+        next_ = missed ? current + period_ : next_ + period_;
+        return !missed;
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    return true;
+  }
+
+private:
+  static rclcpp::Duration periodFromFrequency(double frequency)
+  {
+    if (!std::isfinite(frequency) || frequency <= 0.0) {
+      throw std::invalid_argument("Controller frequency must be positive and finite");
+    }
+    return rclcpp::Duration::from_seconds(1.0 / frequency);
+  }
+
+  rclcpp::Clock::SharedPtr clock_;
+  rclcpp::Duration period_;
+  rclcpp::Time last_observed_;
+  rclcpp::Time next_;
+};
+}  // namespace nav2_controller
+#endif  // NAV2_CONTROLLER__ROS_CLOCK_RATE_HPP_
