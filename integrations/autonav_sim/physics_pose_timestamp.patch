+def add_physical_pose_to_description(description: str, model_name: str) -> str:
+    """Timestamped world pose for synthetic sensors and referee diagnostics."""
+    root = ET.fromstring(description)
+    if root.tag != 'robot' or root.find("link[@name='base_link']") is None:
+        raise ValueError('Physical pose publisher requires a URDF base_link')
+    if not any(p.get('name') == 'ignition::gazebo::systems::OdometryPublisher'
+               for p in root.findall('gazebo/plugin')):
+        gazebo = ET.SubElement(root, 'gazebo')
+        plugin = ET.SubElement(gazebo, 'plugin',
+            filename='ignition-gazebo-odometry-publisher-system',
+            name='ignition::gazebo::systems::OdometryPublisher')
+        for key, value in (('odom_frame', 'world'), ('robot_base_frame', model_name),
+                           ('odom_publish_frequency', '50'), ('dimensions', '2'),
+                           ('odom_topic', '/igvc_sim/physics_odom'),
+                           ('odom_covariance_topic', '/igvc_sim/physics_odom_covariance'),
+                           ('tf_topic', '/igvc_sim/physics_pose')):
+            ET.SubElement(plugin, key).text = value
+    return ET.tostring(root, encoding='unicode')
