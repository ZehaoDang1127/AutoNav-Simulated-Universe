+"""Spatial candidates for exact tape-distance tests during sensor generation."""
+import math
+
+
+def build_tape_index(tapes):
+    """Index width-expanded segment bounds in 1 m cells.
+
+    The original exact point-to-segment test still decides each return;
+    this only avoids visiting distant segments for every LiDAR beam.
+    """
+    index = {}
+    for tape in tapes:
+        half_width = 0.5 * tape.width_m
+        min_x = math.floor(min(tape.start[0], tape.end[0]) - half_width)
+        max_x = math.floor(max(tape.start[0], tape.end[0]) + half_width)
+        min_y = math.floor(min(tape.start[1], tape.end[1]) - half_width)
+        max_y = math.floor(max(tape.start[1], tape.end[1]) + half_width)
+        for ix in range(min_x, max_x + 1):
+            for iy in range(min_y, max_y + 1):
+                index.setdefault((ix, iy), []).append(tape)
+    return {key: tuple(values) for key, values in index.items()}
