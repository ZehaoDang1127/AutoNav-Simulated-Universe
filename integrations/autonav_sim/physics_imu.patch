+"""Fortress IMU setup and angular-rate-only ROS adapter."""
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+import rclpy
+from rclpy.node import Node
+from rclpy.qos import qos_profile_sensor_data
+from sensor_msgs.msg import Imu
+
+
+def add_imu_to_description(description: str) -> str:
+    root = ET.fromstring(description)
+    if root.tag != 'robot' or root.find("link[@name='base_link']") is None:
+        raise ValueError('Physics IMU requires a URDF base_link')
+    gazebo = ET.SubElement(root, 'gazebo', reference='base_link')
+    sensor = ET.SubElement(gazebo, 'sensor', name='igvc_physics_imu', type='imu')
+    for key, value in (('always_on', 'true'), ('update_rate', '50'),
+                       ('topic', '/igvc_sim/physics_imu')):
+        ET.SubElement(sensor, key).text = value
+    imu = ET.SubElement(sensor, 'imu')
+    angular = ET.SubElement(imu, 'angular_velocity')
+    for axis in ('x', 'y', 'z'):
+        noise = ET.SubElement(ET.SubElement(angular, axis), 'noise', type='gaussian')
+        ET.SubElement(noise, 'mean').text = '0'
+        ET.SubElement(noise, 'stddev').text = '0.005'
+    return ET.tostring(root, encoding='unicode')
+
+
+def add_imu_system(world: str) -> str:
+    root = ET.fromstring(world)
+    node = root.find('world')
+    if node is None:
+        raise ValueError('Physics IMU requires an SDF world')
+    if not any('imu-system' in plugin.get('filename', '') for plugin in node.findall('plugin')):
+        ET.SubElement(node, 'plugin', filename='ignition-gazebo-imu-system',
+                      name='ignition::gazebo::systems::Imu')
+    return ET.tostring(root, encoding='unicode')
+
+
+def save_runtime_input(text: str, name: str, directory: str) -> str:
+    path = Path(directory) / name
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding='utf-8')
+    return str(path)
+
+
+class PhysicsGyro(Node):
+    def __init__(self):
+        super().__init__('igvc_physics_gyro')
+        self.publisher = self.create_publisher(Imu, '/imu/data', qos_profile_sensor_data)
+        self.subscription = self.create_subscription(
+            Imu, '/igvc_sim/physics_imu', self.callback, qos_profile_sensor_data)
+
+    def callback(self, source):
+        message = Imu()
+        message.header.stamp = source.header.stamp
+        message.header.frame_id = 'base_link'
+        message.orientation.w = 1.0
+        message.orientation_covariance[0] = -1.0
+        message.linear_acceleration_covariance[0] = -1.0
+        message.angular_velocity = source.angular_velocity
+        message.angular_velocity_covariance = [.000025, 0., 0., 0., .000025, 0., 0., 0., .000025]
+        self.publisher.publish(message)
+
+
+def main(args=None):
+    rclpy.init(args=args)
+    node = PhysicsGyro()
+    try:
+        rclpy.spin(node)
+    finally:
+        node.destroy_node()
+        if rclpy.ok():
+            rclpy.shutdown()
