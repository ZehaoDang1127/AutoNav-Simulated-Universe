+def _gps_ekf_process(context, *args, **kwargs):
+    if not _truthy(context, "launch_gps_ekf"):
+        return []
+    if not _truthy(context, "launch_local_ekf"):
+        raise ValueError("launch_gps_ekf requires launch_local_ekf")
+    config = os.path.join(_package_share("igvc_competition_sim"), "config")
+    return [
+        Node(package="robot_localization", executable="ekf_node", name="global_ekf",
+             output="screen", parameters=[os.path.join(config, "global_sensor_ekf.yaml"),
+                                           {"use_sim_time": True}],
+             remappings=[("odometry/filtered", "/global_ekf/odom")]),
+        Node(package="robot_localization", executable="navsat_transform_node",
+             name="navsat_transform", output="screen",
+             parameters=[os.path.join(config, "navsat_sensor.yaml"),
+                         {"use_sim_time": True}],
+             remappings=[("gps/fix", "/gps_fix"),
+                         ("odometry/filtered", "/global_ekf/odom"),
+                         ("odometry/gps", "/odometry/gps")]),
+    ]
