diff --git a/igvc_competition_sim/config/global_sensor_ekf.yaml b/igvc_competition_sim/config/global_sensor_ekf.yaml
new file mode 100644
--- /dev/null
+++ b/igvc_competition_sim/config/global_sensor_ekf.yaml
@@ -0,0 +1,21 @@
+global_ekf:
+  ros__parameters:
+    frequency: 30.0
+    sensor_timeout: 0.3
+    two_d_mode: true
+    publish_tf: true
+    map_frame: map
+    odom_frame: odom
+    base_link_frame: base_link
+    world_frame: map
+    odom0: /local_ekf/odom
+    # Continuous gyro heading/body velocity; no integrated wheel position.
+    odom0_config: [false, false, false, false, false, true,
+                   true, true, false, false, false, true,
+                   false, false, false]
+    odom0_queue_size: 10
+    odom1: /odometry/gps
+    odom1_config: [true, true, false, false, false, false,
+                   false, false, false, false, false, false,
+                   false, false, false]
+    odom1_queue_size: 10
diff --git a/igvc_competition_sim/config/navsat_sensor.yaml b/igvc_competition_sim/config/navsat_sensor.yaml
new file mode 100644
--- /dev/null
+++ b/igvc_competition_sim/config/navsat_sensor.yaml
@@ -0,0 +1,13 @@
+navsat_transform:
+  ros__parameters:
+    frequency: 10.0
+    delay: 0.3
+    zero_altitude: true
+    # The exported course starts with the robot facing map east (yaw zero).
+    # Gyro-integrated odometry preserves that initial heading convention.
+    use_odometry_yaw: true
+    yaw_offset: 0.0
+    magnetic_declination_radians: 0.0
+    wait_for_datum: false
+    broadcast_utm_transform: false
+    publish_filtered_gps: false
