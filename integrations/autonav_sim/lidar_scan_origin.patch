+def _lidar_planar_frame_process(context, *args, **kwargs):
+    # LaserScan ray origins must share the sensor's XY mount. An upright
+    # ground-projected frame retains the existing PCA height filter while
+    # avoiding the physical lidar mount's upside-down roll.
+    geometry = _active_robot_profile(context).geometry
+    if geometry is None:
+        from igvc_competition_sim.course import load_course
+        geometry = load_course(LaunchConfiguration("course_config").perform(context)).robot
+    return [Node(package="tf2_ros", executable="static_transform_publisher",
+                 name="lidar_planar_transform", output="screen",
+                 arguments=[str(geometry.lidar_x_from_base_link_m), "0", "0", "0", "0", "0",
+                            "base_link", "lidar_planar"])]
