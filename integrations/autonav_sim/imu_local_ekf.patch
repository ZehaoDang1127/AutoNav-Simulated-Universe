+    def _publish_imu(self, stamp: Time) -> None:
+        # Physics and odom timer callbacks may execute concurrently.
+        with self._imu_lock:
+            IgvcSensorHarness._publish_imu_locked(self, stamp)
+
+    def _publish_imu_locked(self, stamp: Time) -> None:
+        # Synthetic gyro, like the synthetic GPS/LiDAR: sample actual physics
+        # motion. Publish angular velocity only, never ground-truth position
+        # or absolute yaw to the estimator.
+        if self._imu_physics_yaw is None:
+            return
+        # Differentiate on physics timestamps, not timer receipt times. A
+        # held pose otherwise generates alternating zero/rate-spike samples.
+        sample_stamp = self._imu_physics_stamp
+        if sample_stamp is None:
+            return
+        sample_s = _stamp_to_float(sample_stamp)
+        yaw = self._imu_physics_yaw
+        rate = 0.0
+        if self._imu_previous_s is not None and sample_s <= self._imu_previous_s:
+            if _stamp_to_float(stamp) - sample_s <= 0.10:
+                return
+            # Gazebo omits unchanged dynamic poses. Supply a stationary gyro
+            # heartbeat after that feed becomes quiet. Its held yaw is
+            # also the finite-difference reference at this newer time;
+            # otherwise resuming motion averages a turn over the whole
+            # stopped interval and silently loses accumulated heading.
+            sample_stamp = stamp
+            self._imu_previous_s = _stamp_to_float(stamp)
+        else:
+            if self._imu_previous_s is not None:
+                dt = sample_s - self._imu_previous_s
+                delta = math.atan2(math.sin(yaw - self._imu_previous_yaw),
+                                   math.cos(yaw - self._imu_previous_yaw))
+                rate = delta / dt
+            self._imu_previous_s = sample_s
+            self._imu_previous_yaw = yaw
+        msg = Imu()
+        msg.header.stamp = sample_stamp
+        msg.header.frame_id = "base_link"
+        msg.orientation_covariance[0] = -1.0
+        msg.angular_velocity.z = rate + random.gauss(0.0, 0.005)
+        msg.angular_velocity_covariance = [0.0001, 0.0, 0.0,
+                                           0.0, 0.0001, 0.0,
+                                           0.0, 0.0, 0.0001]
+        msg.linear_acceleration_covariance[0] = -1.0
+        self.imu_pub.publish(msg)
 
