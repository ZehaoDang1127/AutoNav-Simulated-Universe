+  static bool sameRequestedGoal(const geometry_msgs::msg::PoseStamped & a,
+                                const geometry_msgs::msg::PoseStamped & b) {
+    const auto & p = a.pose.position;
+    const auto & q = b.pose.position;
+    const auto & u = a.pose.orientation;
+    const auto & v = b.pose.orientation;
+    return a.header.frame_id == b.header.frame_id &&
+      std::hypot(p.x-q.x, p.y-q.y) < 0.01 &&
+      std::abs(u.x*v.x+u.y*v.y+u.z*v.z+u.w*v.w) > 1.0-1e-6;
+  }
+
+  static bool candidateIsLonger(const nav_msgs::msg::Path & candidate,
+                               const nav_msgs::msg::Path & accepted,
+                               double margin, double deviation_limit,
+                               bool known_same_goal) {
+    if (candidate.poses.empty() || accepted.poses.size() < 2 ||
+        candidate.header.frame_id != accepted.header.frame_id) return false;
+    const auto & goal = candidate.poses.back().pose.position;
+    const auto & old_goal = accepted.poses.back().pose.position;
+    // Arrival cells can differ by twice the planner's positional tolerance.
+    // They are not a new mission goal when the original request is unchanged.
+    if (!known_same_goal && std::hypot(goal.x-old_goal.x, goal.y-old_goal.y) > 0.30) return false;
+
+    const auto & start = candidate.poses.front().pose.position;
+    double closest = std::numeric_limits<double>::infinity();
+    double prefix = 0.0, progress = 0.0;
+    for (size_t i = 1; i < accepted.poses.size(); ++i) {
+      const auto & a = accepted.poses[i-1].pose.position;
+      const auto & b = accepted.poses[i].pose.position;
+      const double dx = b.x-a.x, dy = b.y-a.y;
+      const double squared = dx*dx+dy*dy;
+      const double fraction = squared > 1e-12 ? std::clamp(
+        ((start.x-a.x)*dx+(start.y-a.y)*dy)/squared, 0.0, 1.0) : 0.0;
+      const double distance = std::hypot(start.x-a.x-fraction*dx,
+                                        start.y-a.y-fraction*dy);
+      const double length = std::sqrt(squared);
+      if (distance < closest) {
+        closest = distance;
+        progress = prefix + fraction*length;
+      }
+      prefix += length;
+    }
+    if (closest > std::max(0.0, deviation_limit)) return false;
+    return pathLength(candidate) > prefix-progress + std::max(0.0, margin);
+  }
