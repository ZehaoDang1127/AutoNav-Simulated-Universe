+
+std::vector<geometry_msgs::msg::Vector3> LineLayer::filterClassifiedDividers(
+  const std::vector<geometry_msgs::msg::Vector3> & points)
+{
+  if (lane_dividers_.empty()) {return points;}
+  double tx = 0, ty = 0, yaw = 0;
+  const auto global_frame = layered_costmap_->getGlobalFrameID();
+  if (global_frame != lane_semantics_frame_) {
+    try {
+      const auto transform = tf_buffer_->lookupTransform(lane_semantics_frame_, global_frame, tf2::TimePointZero);
+      tx = transform.transform.translation.x;
+      ty = transform.transform.translation.y;
+      yaw = tf2::getYaw(transform.transform.rotation);
+    } catch (const tf2::TransformException &) {
+      return points;  // Uncertain classification stays hard.
+    }
+  }
+  const auto dividers = autonav_lane::segments(lane_dividers_);
+  const auto boundaries = autonav_lane::segments(lane_hard_boundaries_);
+  const double c = std::cos(yaw), s = std::sin(yaw);
+  std::vector<geometry_msgs::msg::Vector3> hard;
+  for (const auto & p : points) {
+    if (!autonav_lane::crossable({tx+c*p.x-s*p.y, ty+s*p.x+c*p.y}, dividers,
+      boundaries, lane_classification_tolerance_m_)) {hard.push_back(p);}
+  }
+  return hard;
 }
 
