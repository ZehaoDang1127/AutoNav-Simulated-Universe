+    def _publish_projected_gps_goal(self, active: "_ActiveGoal") -> None:
+        """Share the global GPS estimator's datum instead of re-estimating it.
+
+        The projection is asynchronous and cached per active waypoint. Waiting
+        for its service never falls back to a drifting world-to-odom target.
+        """
+        with self._lock:
+            if self._active is not active or self._publisher_disabled:
+                return
+            if active.projected_goal_map is None:
+                if active.projected_goal_future is None:
+                    if not self._navsat_client.service_is_ready():
+                        return
+                    request = FromLL.Request()
+                    request.ll_point.latitude, request.ll_point.longitude = active.goal_lat_lon
+                    active.projected_goal_future = self._navsat_client.call_async(request)
+                if not active.projected_goal_future.done():
+                    return
+                try:
+                    point = active.projected_goal_future.result().map_point
+                    if not (math.isfinite(point.x) and math.isfinite(point.y)):
+                        raise ValueError("nonfinite GPS map projection")
+                    active.projected_goal_map = (point.x, point.y)
+                except Exception as exc:
+                    active.projected_goal_future = None
+                    self.get_logger().warn(f"GPS map projection failed: {exc}")
+                    return
+            goal_map = active.projected_goal_map
+        self._publish_local_map_goal(active, goal_map)
+        with self._lock:
