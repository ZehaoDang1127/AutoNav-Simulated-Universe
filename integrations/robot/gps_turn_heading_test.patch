+def test_paired_heading_fit_stays_stable_during_turn() -> None:
+    """Windowed GPS travel must be compared with windowed odom travel."""
+    history: List[HistoryEntry] = []
+    x = y = 0.0
+    for i in range(30):
+        yaw = -0.5 * i / 29
+        x += 0.3 * math.cos(yaw)
+        y += 0.3 * math.sin(yaw)
+        # World and odom frames are aligned, even though the robot turns.
+        history.append((i * 0.5, (x, y), (x, y)))
+    theta, baseline = closed_form_theta_window(
+        history, n_samples=30, min_baseline=1.5,
+    )
+    assert baseline > 1.5
+    assert theta is not None and abs(theta) < 1e-10
+    dx = history[-1][1][0] - history[0][1][0]
+    dy = history[-1][1][1] - history[0][1][1]
+    old_theta = wrap_pi(math.atan2(dy, dx) - (-0.5))
+    assert old_theta > 0.15  # instantaneous-yaw method was biased
+
