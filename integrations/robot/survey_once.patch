@@ -0,0 +1,28 @@
+#include "behaviortree_cpp_v3/decorator_node.h"
+#include "behaviortree_cpp_v3/bt_factory.h"
+
+namespace autonav_bt
+{
+// Retain success across tree halts and successive navigation goals. A fresh
+// navigator/tree must survey again. Failure or cancellation never skips it.
+class SurveyOnce : public BT::DecoratorNode
+{
+public:
+  using BT::DecoratorNode::DecoratorNode;
+  static BT::PortsList providedPorts() {return {};}
+  BT::NodeStatus tick() override
+  {
+    if (completed_) {return BT::NodeStatus::SUCCESS;}
+    const auto result = child_node_->executeTick();
+    if (result == BT::NodeStatus::SUCCESS) {completed_ = true;}
+    return result;
+  }
+private:
+  bool completed_{false};
+};
+}  // namespace autonav_bt
+
+BT_REGISTER_NODES(factory)
+{
+  factory.registerNodeType<autonav_bt::SurveyOnce>("SurveyOnce");
+}
