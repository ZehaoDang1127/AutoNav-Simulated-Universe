+    def _goal_distance_m(self, active: "_ActiveGoal") -> Optional[float]:
+        """Measure GPS arrival at the antenna in the target's projection.
+
+        The internal EKF estimates base_link, while a GPS waypoint locates
+        the receiver. A shared navsat projection must also share map TF for
+        arrival; comparing it to the independent first-fix EKF mixes datums.
+        Missing projection or antenna TF cannot declare GPS arrival.
+        """
+        if active.goal_type == NavigateToWaypoint.Goal.GOAL_TYPE_LOCAL:
+            position = self._lookup_robot_in_map()
+            if position is None:
+                with self._lock:
+                    position = self._ekf.pos_xy
+            target = active.goal_world_xy
+        elif self._use_navsat_projection:
+            target = active.projected_goal_map
+            if target is None:
+                return None
+            try:
+                transform = self._tf_buffer.lookup_transform(
+                    self._map_frame, GPS_LINK_FRAME, Time(),
+                    rclpy.duration.Duration(seconds=self._tf_timeout_s))
+            except (LookupException, ConnectivityException, ExtrapolationException):
+                return None
+            position = (float(transform.transform.translation.x),
+                        float(transform.transform.translation.y))
+        else:
+            with self._lock:
+                offset = self._gps_link_offset_xy
+                if offset is None:
+                    return None
+                bx, by = self._ekf.pos_xy
+                yaw = self._last_odom_yaw + self._ekf.theta
+                ax, ay = offset
+                position = (bx + math.cos(yaw)*ax - math.sin(yaw)*ay,
+                            by + math.sin(yaw)*ax + math.cos(yaw)*ay)
+            target = active.goal_world_xy
+        return math.hypot(position[0] - target[0], position[1] - target[1])
+
