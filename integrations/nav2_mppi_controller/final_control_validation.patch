+bool Optimizer::validateControlSequence()
+{
+  // MPPI's weighted mean and temporal filter can cross an obstacle even when
+  // individual samples are safe. Re-score the final physical body trajectory.
+  models::State candidate;
+  candidate.reset(1, settings_.time_steps);
+  candidate.pose = state_.pose;
+  candidate.speed = state_.speed;
+  xt::view(candidate.cvx, 0, xt::all()) = control_sequence_.vx;
+  xt::view(candidate.cwz, 0, xt::all()) = control_sequence_.wz;
+  if (isHolonomic()) {xt::view(candidate.cvy, 0, xt::all()) = control_sequence_.vy;}
+  updateStateVelocities(candidate);
+  models::Trajectories trajectory;
+  trajectory.reset(1, settings_.time_steps);
+  integrateStateVelocities(trajectory, candidate);
+  auto costs = xt::zeros<float>({1u});
+  xt::xtensor<float, 1> score = costs;
+  CriticData data{candidate, trajectory, path_, score, settings_.model_dt, false,
+    critics_data_.goal_checker, motion_model_, std::nullopt, std::nullopt};
+  critic_manager_.evalTrajectoriesScores(data);
+  return !data.fail_flag;
+}
+
+bool Optimizer::validateEmergencyStop()
+{
+  auto * calibrated = dynamic_cast<CalibratedDiffDriveMotionModel *>(motion_model_.get());
+  if (!calibrated) {return true;}
+  // A path guard may halt FollowPath after this action. The physical body
+  // must remain clear while command smoothing, latency, and inertia brake it.
+  const auto requested = control_sequence_;
+  calibrated->brakeControlSequence(control_sequence_);
+  const bool safe = validateControlSequence();
+  control_sequence_ = requested;
+  return safe;
+}
+
+bool Optimizer::selectCollisionFreeControl()
+{
+  if (validateControlSequence() && validateEmergencyStop()) {return true;}
+  // Preserve motion when the blend is unsafe: select a scored sample, then
+  // validate its bounded control sequence against the same locked costmap.
+  std::vector<size_t> order(state_.cvx.shape(0));
+  std::iota(order.begin(), order.end(), 0);
+  std::stable_sort(order.begin(), order.end(),
+    [this](size_t a, size_t b) {return costs_(a) < costs_(b);});
+  for (const size_t sample : order) {
+    control_sequence_.vx = xt::view(state_.cvx, sample, xt::all());
+    control_sequence_.wz = xt::view(state_.cwz, sample, xt::all());
+    if (isHolonomic()) {control_sequence_.vy = xt::view(state_.cvy, sample, xt::all());}
+    // Apply the same temporal filter as the optimized mean, without
+    // committing history for a candidate that may never be issued.
+    auto filter_history = control_history_;
+    utils::savitskyGolayFilter(control_sequence_, filter_history, settings_);
+    applyControlSequenceConstraints();
+    if (validateControlSequence() && validateEmergencyStop()) {
+      RCLCPP_DEBUG(logger_, "Unsafe MPPI blend replaced with a validated sampled control");
+      return true;
+    }
+  }
+  return false;
+}
