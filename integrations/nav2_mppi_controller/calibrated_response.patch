@@ -0,0 +1,75 @@
+#ifndef NAV2_MPPI_CONTROLLER__CALIBRATED_DIFF_DRIVE_HPP_
+#define NAV2_MPPI_CONTROLLER__CALIBRATED_DIFF_DRIVE_HPP_
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+#include "nav2_mppi_controller/motion_models.hpp"
+#include "nav2_mppi_controller/models/optimizer_settings.hpp"
+
+namespace mppi
+{
+// Predict the measured vehicle response without changing its command limits.
+// Unobserved commands already in flight are initialized to measured velocity.
+class CalibratedDiffDriveMotionModel : public DiffDriveMotionModel
+{
+public:
+  CalibratedDiffDriveMotionModel(
+    models::OptimizerSettings & settings, ParametersHandler * handler = nullptr,
+    const std::string & name = "")
+  : settings_(settings)
+  {
+    if (handler) {
+      auto getParam = handler->getParamGetter(name + ".CalibratedDiffDrive");
+      getParam(latency_, "command_latency_s", 0.08f);
+      getParam(linear_tau_, "linear_time_constant_s", 0.20f);
+      getParam(angular_tau_, "angular_time_constant_s", 0.18f);
+      getParam(linear_accel_, "max_linear_acceleration_mps2", 1.0f);
+      getParam(angular_accel_, "max_angular_acceleration_radps2", 2.0f);
+    }
+  }
+
+  void predict(models::State & state) override
+  {
+    const float dt = settings_.model_dt;
+    if (!(dt > 0) || latency_ < 0 || linear_tau_ < 0 || angular_tau_ < 0 ||
+      !(linear_accel_ > 0) || !(angular_accel_ > 0))
+    {
+      throw std::invalid_argument("Invalid calibrated MPPI response parameters");
+    }
+    const auto & limits = settings_.constraints;
+    // Preserve Gaussian perturbations for MPPI's weighted control update.
+    // Saturate the predicted actuator response instead: clipping perturbations
+    // before averaging biases commands away from their upper/lower limits.
+    const int substeps = std::max(1, static_cast<int>(std::ceil(dt / .02f)));
+    const float sub_dt = dt / substeps;
+    const float alpha_v = linear_tau_ > 1e-6f ? 1-std::exp(-sub_dt/linear_tau_) : 1;
+    const float alpha_w = angular_tau_ > 1e-6f ? 1-std::exp(-sub_dt/angular_tau_) : 1;
+    const size_t steps = state.vx.shape(1);
+    for (size_t i = 0; i < state.vx.shape(0); ++i) {
+      float v = state.vx(i,0), w = state.wz(i,0);
+      const float initial_v = v, initial_w = w;
+      for (size_t j = 1; j < steps; ++j) {
+        for (int sub = 1; sub <= substeps; ++sub) {
+          const float time = (j-1)*dt + sub*sub_dt - latency_;
+          const int command = static_cast<int>(std::floor((time+1e-6f)/dt));
+          const float target_v = time < -1e-6f ? initial_v :
+            std::clamp(state.cvx(i,command), limits.vx_min, limits.vx_max);
+          const float target_w = time < -1e-6f ? initial_w :
+            std::clamp(state.cwz(i,command), -limits.wz, limits.wz);
+          v += std::clamp(alpha_v*(target_v-v), -linear_accel_*sub_dt, linear_accel_*sub_dt);
+          w += std::clamp(alpha_w*(target_w-w), -angular_accel_*sub_dt, angular_accel_*sub_dt);
+        }
+        state.vx(i,j) = v;
+        state.wz(i,j) = w;
+      }
+    }
+  }
+
+private:
+  models::OptimizerSettings & settings_;
+  float latency_{.08f}, linear_tau_{.20f}, angular_tau_{.18f};
+  float linear_accel_{1.0f}, angular_accel_{2.0f};
+};
+}  // namespace mppi
+#endif  // NAV2_MPPI_CONTROLLER__CALIBRATED_DIFF_DRIVE_HPP_
